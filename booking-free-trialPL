  <!-- SCRIPT DE REDIRECIONAMENTO POR IP -->
  <script>
    (async function() {
      const manualLang = localStorage.getItem('user_lang');
      const currentPath = window.location.pathname;
      if (manualLang) return; 

      try {
        const response = await fetch('https://get.geojs.io/v1/ip/country.json');
        const data = await response.json();
        const country = data.country;
        const esCountries = ['ES','MX','AR','CO','CL','PE','VE','EC','GT','CU','BO','DO','HN','PY','SV','NI','CR','PA','PR','UY','GQ'];
        
        let targetUrl = '/booking-free-trialEN.html'; 
        if (country === 'BR') targetUrl = '/booking-free-trialBR.html';
        else if (country === 'PL') targetUrl = '/booking-free-trialPL.html';
        else if (esCountries.includes(country)) targetUrl = '/booking-free-trialES.html';

        const targetFile = targetUrl.replace('/', '');
        if (!currentPath.includes(targetFile)) {
          window.location.replace(targetUrl);
        }
      } catch(e) {}
    })();

    function switchLang(lang, currency, url) {
      localStorage.setItem('user_lang', lang);
      if(currency) localStorage.setItem('preferredCurrency', currency);
      window.location.href = url;
    }
  </script>

