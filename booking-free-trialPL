  <script>
    const API_URL = "https://script.google.com/macros/s/AKfycbwxzYWgEdGsUqjokKIMroI1xmZYE1LQcj4sd8EIoODbDWA5MIxa0xEb85JTuvAQnVMtXA/exec";
    function toggleMobileMenu() { document.getElementById('mobileMenu').classList.toggle('hidden'); }
    function closeMobileMenu() { document.getElementById('mobileMenu').classList.add('hidden'); }
    function openTrialModal() { document.getElementById('trialModal').classList.remove('hidden'); goToTrialStep(1); }
    function closeTrialModal() { document.getElementById('trialModal').classList.add('hidden'); }
    function goToTrialStep(step) {
      document.querySelectorAll('.trial-step').forEach(el => el.classList.add('hidden'));
      if(step===2){ document.getElementById('step2Company').value = document.getElementById('step1Company').value; }
      document.getElementById('trialStep' + step).classList.remove('hidden');
    }
    async function finishTrial(e) {
      e.preventDefault();
      const btn = document.getElementById('btnCompleteTrial');
      btn.innerText = "Wysyłanie..."; btn.disabled = true;
      const payload = {
        action: 'submitTrial', token: 'alan_admin_2026',
        company: document.getElementById('step2Company').value,
        phone: document.getElementById('trialPhone').value,
        country: document.getElementById('trialCountry').value
      };
      try {
        await fetch(API_URL, { method: 'POST', body: JSON.stringify(payload) });
        goToTrialStep('Success');
        setTimeout(closeTrialModal, 2500);
      } catch (err) { btn.innerText = "Zakończ"; btn.disabled = false; }
    }
  </script>
